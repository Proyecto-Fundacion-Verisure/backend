DB_URL=jdbc:postgresql://localhost:5432/db-verisure
DB_USER=
DB_PASSWORD=

# Enlaces de los correos y CORS
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173

# JWT. Sin valor por defecto: generar el secreto con
#   openssl rand -base64 64
# Si falta, la aplicacion no arranca.
JWT_SECRET=
JWT_EXPIRATION_MS=7200000

# Correo. Buzon de pruebas (Mailtrap): sin MAIL_HOST la aplicacion arranca
# igual y los envios quedan como aviso en el registro.
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@verisure.ex
